{
  "expo": {
    "name": "Kayalaya",
    "slug": "Kayalaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.Kayalaya"
    },
    "web": {
      "favicon": "./assets/images/kayalaya.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kayalaya to access your camera for pose detection."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9b3572a-b717-4ec5-9325-e8ddb9f167ad"
      }
    }
  }
}
